#!/usr/bin/env bash
set -euo pipefail

commit_msg_file="${1:-}"
if [[ -z "${commit_msg_file}" || ! -f "${commit_msg_file}" ]]; then
  echo "commit-msg hook: missing commit message file path" >&2
  exit 1
fi

# Remove AI-style attribution trailers and generator signatures.
perl -i -ne '
  next if /^Made-with:/i;
  next if /^Made with:/i;
  next if /^Generated by.*\b(?:AI|Cursor|ChatGPT|Claude|Copilot|GPT|LLM)\b/i;
  next if /^AI-generated:/i;
  next if /^Co-authored-by:/i;
  print;
' "$commit_msg_file"
